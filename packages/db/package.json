{
  "name": "@olis/db",
  "type": "module",
  "version": "1.0.0",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/platform": "./src/schema/platform/index.ts",
    "./schema/identity": "./src/schema/identity/index.ts",
    "./schema/marketplace": "./src/schema/marketplace/index.ts",
    "./schema/remodel-x": "./src/schema/remodel-x/index.ts",
    "./seeds/platform": "./src/seeds/platform/index.ts",
    "./seeds/identity": "./src/seeds/identity/index.ts",
    "./seeds/marketplace": "./src/seeds/marketplace/index.ts",
    "./seeds/remodel-x": "./src/seeds/remodel-x/index.ts",
    "./seeds/*": "./src/seeds/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:init-schemas": "dotenv -e .env tsx ./src/lib/init-schemas.ts",
    "db:push:platform": "dotenv -e .env drizzle-kit push --strict --verbose --schema=./src/schema/platform/index.ts --schemaFilter=platform --dialect=postgresql --url=$DATABASE_URL",
    "db:reset:platform": "dotenv -e .env tsx ./src/lib/db-reset.ts platform",
    "db:seed:platform": "dotenv -e .env tsx ./src/lib/db-seed.ts platform",
    "db:push:identity": "dotenv -e .env drizzle-kit push --strict --verbose --schema=./src/schema/identity/index.ts --schemaFilter=identity --dialect=postgresql --url=$DATABASE_URL",
    "db:reset:identity": "dotenv -e .env tsx ./src/lib/db-reset.ts identity",
    "db:seed:identity": "dotenv -e .env tsx ./src/lib/db-seed.ts identity",
    "db:push:marketplace": "dotenv -e .env drizzle-kit push --strict --verbose --schema=./src/schema/marketplace/index.ts --schemaFilter=marketplace --dialect=postgresql --url=$DATABASE_URL",
    "db:reset:marketplace": "dotenv -e .env tsx ./src/lib/db-reset.ts marketplace",
    "db:seed:marketplace": "dotenv -e .env tsx ./src/lib/db-seed.ts marketplace",
    "db:push:remodel-x": "dotenv -e .env drizzle-kit push --strict --verbose --schema=./src/schema/remodel-x/index.ts --schemaFilter=remodel_x --dialect=postgresql --url=$DATABASE_URL",
    "db:reset:remodel-x": "dotenv -e .env tsx ./src/lib/db-reset.ts oneStopSales",
    "db:seed:remodel-x": "dotenv -e .env tsx ./src/lib/db-seed.ts oneStopSales"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@olis/core": "workspace:*",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.6",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.0.0",
    "@olis/eslint-config": "workspace:*",
    "@olis/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.34.0",
    "eslint-plugin-format": "^1.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
